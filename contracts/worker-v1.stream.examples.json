        "voice": "af_heart",
        "speed": 1.0
      }
    },
    "cancel": {
      "protocolVersion": 1,
      "id": "cancel-voice-1",
      "op": "cancel",
      "params": { "target": "voice-1" }
    }
  },
  "responses": {
    "audioChunk": {
      "protocolVersion": 1,
      "id": "voice-1",
      "event": "audio_chunk",
      "index": 0,
